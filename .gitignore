# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# Dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Generated native folders
/ios
/android

# Metro
.metro-health-check*

# Debug
npm-debug.*
yarn-debug.*
yarn-error.*

# Local env files — never commit secrets
.env
.env*.local

# TypeScript
*.tsbuildinfo

# macOS
.DS_Store
**/.DS_Store
*.pem

# Editor
.vscode/
.idea/
.cursor/
.claude/
node_modules/.deno/

# Python (offline tooling, local scripts)
__pycache__/
*.py[cod]

# Generated local asset backups / logs
TightLinesAI/assets/images/_backups/
TightLinesAI/scripts/_tackle-gen-full.log

# Generated local review artifacts
TightLinesAI/tmp/

# Local store-listing artwork and one-off render tooling. These are archived
# outside Git and excluded from EAS builds; keep the mobile repository lean.
/TightLinesAI/assets/store-listing/
/FinFindr-Google-Play-*
/FinFindr-Logo-Concept-Folded-Current.png
/tmp/

# Generated Cloudflare Pages upload bundles
cloudflare-upload/
finfindr-cloudflare-upload/
finfindr-cloudflare-upload.zip

# Generated audit JSONL artifacts can be very large; commit scripts and Markdown
# summaries instead, then regenerate JSONL locally when needed.
TightLinesAI/scripts/audit/todays-bite*.jsonl
TightLinesAI/scripts/audit/daily-picks-archive-audit.*.jsonl
TightLinesAI/scripts/audit/archive-audit-results*.jsonl
TightLinesAI/scripts/audit/audit-results.json
