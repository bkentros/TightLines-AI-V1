# EAS archives from the Git root. Exclude material outside the mobile app.
/.git/
/.claire/
/.claude/
/.cursor/
/.github/
/.wrangler/
/docs/
/legal-site/
/lib/
/deliverables/
/tmp/
/*.jpg
/*.png

# Dependencies and local tooling
/TightLinesAI/node_modules/
/TightLinesAI/.venv-rembg/
/TightLinesAI/.tools/
/TightLinesAI/.expo/
/TightLinesAI/.eas/
/TightLinesAI/dist/
/TightLinesAI/web-build/
/TightLinesAI/expo-env.d.ts

# Native projects are generated by EAS prebuild
/TightLinesAI/ios/
/TightLinesAI/android/

# Local environment files
/TightLinesAI/.env
/TightLinesAI/.env.local
/TightLinesAI/.env.*.local

# Backend, audit, and documentation sources are not part of the mobile binary
/TightLinesAI/supabase/
/TightLinesAI/scripts/
/TightLinesAI/docs/
/TightLinesAI/tmp/
/TightLinesAI/assets/store-listing/

# Editor, operating-system, log, and compiler metadata
/TightLinesAI/.DS_Store
/TightLinesAI/**/.DS_Store
/TightLinesAI/.vscode/
/TightLinesAI/.idea/
/TightLinesAI/npm-debug.log*
/TightLinesAI/yarn-debug.log*
/TightLinesAI/yarn-error.log*
/TightLinesAI/*.tsbuildinfo
