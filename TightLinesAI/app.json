{
  "expo": {
    "name": "FinFindr",
    "slug": "tightlines-ai",
    "version": "1.0.4",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a1628"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.finseekr.finfindr",
      "buildNumber": "24",
      "infoPlist": {
        "CFBundleDisplayName": "FinFindr",
        "CFBundleName": "FinFindr",
        "ITSAppUsesNonExemptEncryption": false,
        "UIDesignRequiresCompatibility": false
      },
      "usesAppleSignIn": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#0a1628"
      },
      "package": "com.finseekr.finfindr"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "FinFindr uses your location to auto-fill weather, tide, and moon conditions for better fishing recommendations.",
          "locationAlwaysAndWhenInUsePermission": "FinFindr uses your location to auto-fill weather, tide, and moon conditions for better fishing recommendations."
        }
      ],
      "expo-apple-authentication",
      [
        "react-native-nitro-google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.655199773804-0r0e6np654jqvtop64bdpg7fjrfs2i76"
        }
      ],
      "expo-local-authentication",
      "expo-asset",
      "expo-font",
      "expo-image",
      "expo-localization"
    ],
    "scheme": "finfindr",
    "extra": {
      "eas": {
        "projectId": "fbe2fc29-e0ac-49f0-a755-5a7c5f233d31"
      }
    }
  }
}
